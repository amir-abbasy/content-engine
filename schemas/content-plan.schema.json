{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "content-plan.schema.json",
  "title": "ContentPlan",
  "description": "Layer 1 artifact. The SEMANTIC plan for a video — what each scene says and why it exists. AI-authored, schema-validated. Contains NO selectors, timings, or Playwright actions: those belong to the compiler-generated execution pipeline. Every `actionRef` MUST resolve against the flow's Semantic Anchor Table or the compile fails.",
  "type": "object",
  "required": ["video", "build"],
  "additionalProperties": false,
  "properties": {
    "video": {
      "type": "object",
      "required": ["flow", "title"],
      "additionalProperties": false,
      "properties": {
        "flow": { "type": "string", "description": "Flow name; resolves the IR + anchor table (e.g. \"macd\")." },
        "title": { "type": "string" },
        "tone": { "type": "string", "description": "e.g. educational_cinematic. Drives asset/emotion selection downstream." },
        "targetDurationSec": { "type": "number", "description": "Soft target; the pacing solver reports the actual narration-driven duration." }
      }
    },
    "hook":      { "$ref": "#/$defs/scene" },
    "preview":   { "$ref": "#/$defs/scene" },
    "education": { "$ref": "#/$defs/scene" },
    "build": {
      "type": "object",
      "description": "The on-camera node-by-node build. Each segment's `actionRef` binds its narration line to a node's action group; the pacing solver makes the visual fit the spoken line.",
      "required": ["voiceoverSegments"],
      "additionalProperties": false,
      "properties": {
        "voiceoverSegments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["line", "actionRef"],
            "additionalProperties": false,
            "properties": {
              "line": { "type": "string", "description": "Spoken narration for this beat." },
              "actionRef": { "type": "string", "description": "semanticId from the anchor table (e.g. \"ta_macd\", \"plot_1\")." },
              "emotion": { "type": "string" }
            }
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventRef", "line"],
        "additionalProperties": false,
        "properties": {
          "eventRef": { "type": "string" },
          "line": { "type": "string" },
          "emotion": { "type": "string" }
        }
      }
    },
    "backtest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line": { "type": "string" },
        "focusMetrics": {
          "type": "array",
          "items": { "type": "string", "enum": ["winrate", "profitFactor", "drawdown", "totalReturn", "trades", "sharpe"] }
        }
      }
    },
    "outro": { "$ref": "#/$defs/scene" }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "description": "Narrative role, e.g. curiosity / preview / cta." },
        "voiceover": { "type": "string" },
        "visualMood": { "type": "string" },
        "assetTags": { "type": "array", "items": { "type": "string" } },
        "cta": { "type": "string" }
      }
    }
  }
}

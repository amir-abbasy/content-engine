{
  "$schema": "./pipeline.schema.json",
  "name": "algo-trading-reel-01",
  "app": {
    "url": "http://localhost:3000/",
    "viewport": { "width": 1920, "height": 1080 },
    "waitForPyodide": true,
    "pyodideLoaderSelector": ".app-pyodide-loader",
    "readySelector": "#main-chart",
    "readyTimeoutMs": 120000
  },
  "record": {
    "browser": "chromium",
    "headless": false,
    "timelineOffsetMs": 0,
    "settleMs": 600,
    "humanize": {
      "seed": 7,
      "jitter": 0.15,
      "scale": 1.0,
      "preActionPause": [120, 280]
    },
    "cursor": {
      "movement": "human",
      "duration": [380, 720],
      "overshoot": 0.12,
      "hesitation": [70, 180],
      "curvature": 0.4
    }
  },
  "output": {
    "dir": "output",
    "resolution": { "width": 1080, "height": 1920 },
    "fps": 30,
    "fitMode": "cover",
    "keepRaw": true
  },
  "scenes": [
    {
      "id": "01-build-strategy",
      "description": "Build Candles -> EMA(20) + EMA(50) -> Plot left-to-right via right-click search. Camera holds on the menu area while the cursor finds + adds each node, then eases to reveal the placed node before pulling back for the next.",
      "target": { "selector": ".react-flow", "aspect": "9:16", "anchor": "center" },
      "setup": [
        { "at": 0.0, "type": "press", "key": "Digit2", "shift": true },
        { "at": 0.5, "type": "injectFlow", "file": "flows/ema-plot.json" },
        { "at": 1.8, "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 0 }
      ],
      "durationSec": 44.5,
      "holdAfterSec": 1.0,
      "tracks": {
        "input": [
          { "at": 0.3,  "type": "rightClick", "selector": ".react-flow__pane", "position": {"x":  503, "y": 192} },
          { "at": 1.8,  "type": "fill",  "selector": "input[placeholder=\"Search nodes...\"]", "text": "ohlcv" },
          { "at": 3.5,  "type": "click", "selector": "[role=\"menuitem\"]:has-text(\"Candles\")" },
          { "at": 4.8,  "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 1 },

          { "at": 7.3,  "type": "rightClick", "selector": ".react-flow__pane", "position": {"x":  896, "y":  52} },
          { "at": 8.8,  "type": "fill",  "selector": "input[placeholder=\"Search nodes...\"]", "text": "ta.ema" },
          { "at": 10.5, "type": "click", "selector": "[role=\"menuitem\"]" },
          { "at": 11.8, "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 2 },
          { "at": 13.5, "type": "fill",  "selector": ".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]", "text": "20" },

          { "at": 16.3, "type": "rightClick", "selector": ".react-flow__pane", "position": {"x":  896, "y": 452} },
          { "at": 17.8, "type": "fill",  "selector": "input[placeholder=\"Search nodes...\"]", "text": "ta.ema" },
          { "at": 19.5, "type": "click", "selector": "[role=\"menuitem\"]" },
          { "at": 20.8, "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 3 },
          { "at": 22.5, "type": "fill",  "selector": ".react-flow__node[data-id=\"3\"] input[placeholder=\"int\"]", "text": "50" },

          { "at": 25.3, "type": "rightClick", "selector": ".react-flow__pane", "position": {"x": 1386, "y":  52} },
          { "at": 26.8, "type": "fill",  "selector": "input[placeholder=\"Search nodes...\"]", "text": "plot" },
          { "at": 28.5, "type": "click", "selector": "[role=\"menuitem\"]:has(:text-is(\"Plot\"))" },
          { "at": 29.8, "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 4 },
          { "at": 31.5, "type": "click", "selector": ".react-flow__node[data-id=\"4\"]", "position": {"x": 14, "y": 131} },
          { "at": 33.2, "type": "click", "selector": "[role=\"dialog\"] button[title=\"#eab308\"]" },

          { "at": 34.3, "type": "rightClick", "selector": ".react-flow__pane", "position": {"x": 1386, "y": 652} },
          { "at": 35.8, "type": "fill",  "selector": "input[placeholder=\"Search nodes...\"]", "text": "plot" },
          { "at": 37.5, "type": "click", "selector": "[role=\"menuitem\"]:has(:text-is(\"Plot\"))" },
          { "at": 38.8, "type": "injectFlow", "file": "flows/ema-plot.json" },
          { "at": 40.5, "type": "click", "selector": ".react-flow__node[data-id=\"5\"]", "position": {"x": 14, "y": 131} },
          { "at": 42.2, "type": "click", "selector": "[role=\"dialog\"] button[title=\"#06b6d4\"]" }
        ],
        "camera": [
          { "at":  0.0, "point": {"x":  503, "y": 290}, "ease": "cubic-out" },
          { "at":  4.8, "point": {"x":  503, "y": 290}, "ease": "linear" },
          { "at":  5.7, "selector": ".react-flow__node[data-id=\"1\"]", "ease": "cubic-in-out" },
          { "at":  6.4, "selector": ".react-flow__node[data-id=\"1\"]", "ease": "linear" },
          { "at":  7.3, "point": {"x":  896, "y": 200}, "ease": "cubic-in-out" },

          { "at": 11.8, "point": {"x":  896, "y": 200}, "ease": "linear" },
          { "at": 12.7, "selector": ".react-flow__node[data-id=\"2\"]", "ease": "cubic-in-out" },
          { "at": 15.4, "selector": ".react-flow__node[data-id=\"2\"]", "ease": "linear" },
          { "at": 16.3, "point": {"x":  896, "y": 600}, "ease": "cubic-in-out" },

          { "at": 20.8, "point": {"x":  896, "y": 600}, "ease": "linear" },
          { "at": 21.7, "selector": ".react-flow__node[data-id=\"3\"]", "ease": "cubic-in-out" },
          { "at": 24.4, "selector": ".react-flow__node[data-id=\"3\"]", "ease": "linear" },
          { "at": 25.3, "point": {"x": 1386, "y": 200}, "ease": "cubic-in-out" },

          { "at": 29.8, "point": {"x": 1386, "y": 200}, "ease": "linear" },
          { "at": 30.7, "selector": ".react-flow__node[data-id=\"4\"]", "ease": "cubic-in-out" },
          { "at": 33.4, "selector": ".react-flow__node[data-id=\"4\"]", "ease": "linear" },
          { "at": 34.3, "point": {"x": 1386, "y": 800}, "ease": "cubic-in-out" },

          { "at": 38.8, "point": {"x": 1386, "y": 800}, "ease": "linear" },
          { "at": 39.7, "selector": ".react-flow__node[data-id=\"5\"]", "ease": "cubic-in-out" },
          { "at": 42.5, "selector": ".react-flow__node[data-id=\"5\"]", "ease": "linear" }
        ],
        "attention": [
          { "at": 13.0, "type": "mark",      "selector": ".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]" },
          { "at": 13.3, "type": "spotlight", "selector": ".react-flow__node[data-id=\"2\"]" },
          { "at": 15.3, "type": "release" },

          { "at": 22.0, "type": "mark",      "selector": ".react-flow__node[data-id=\"3\"] input[placeholder=\"int\"]" },
          { "at": 22.3, "type": "spotlight", "selector": ".react-flow__node[data-id=\"3\"]" },
          { "at": 24.3, "type": "release" },

          { "at": 31.0, "type": "mark",      "selector": ".react-flow__node[data-id=\"4\"] .aspect-square", "padding": 8 },
          { "at": 31.3, "type": "spotlight", "selector": ".react-flow__node[data-id=\"4\"]" },
          { "at": 32.7, "type": "mark",      "selector": "[role=\"dialog\"] button[title=\"#eab308\"]", "padding": 4 },
          { "at": 34.0, "type": "release" },

          { "at": 40.0, "type": "mark",      "selector": ".react-flow__node[data-id=\"5\"] .aspect-square", "padding": 8 },
          { "at": 40.3, "type": "spotlight", "selector": ".react-flow__node[data-id=\"5\"]" },
          { "at": 41.7, "type": "mark",      "selector": "[role=\"dialog\"] button[title=\"#06b6d4\"]", "padding": 4 },
          { "at": 43.0, "type": "release" }
        ]
      }
    },
    {
      "id": "02-price-chart",
      "description": "Run the finished strategy, then slowly pan the price chart back through history — candles + both EMAs scrolling past with eased motion.",
      "target": { "selector": "#main-chart", "aspect": "9:16", "anchor": "right" },
      "setup": [
        { "at": 0.0, "type": "click", "selector": "button[title=\"Execute flow\"]" },
        { "at": 6.0, "type": "press", "key": "Digit1", "shift": true }
      ],
      "durationSec": 7.0,
      "tracks": {
        "camera": [
          { "at": 0.0, "point": {"x": 1180, "y": 561}, "ease": "cubic-out" },
          { "at": 0.7, "point": {"x": 1180, "y": 561}, "ease": "linear" },
          { "at": 6.0, "point": {"x": 345,  "y": 561}, "ease": "cubic-in-out" }
        ]
      }
    }
  ]
}

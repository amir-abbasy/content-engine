{
  "name": "ema-strategy-reel",
  "app": {
    "url": "http://localhost:3000/",
    "viewport": {"width":1920,"height":1080},
    "waitForPyodide": true,
    "pyodideLoaderSelector": ".app-pyodide-loader",
    "readySelector": "#main-chart",
    "readyTimeoutMs": 120000
  },
  "record": {
    "browser": "chromium",
    "headless": false,
    "timelineOffsetMs": 0,
    "settleMs": 300,
    "humanize": {
      "seed": 7,
      "jitter": 0.15,
      "scale": 1,
      "preActionPause": [
        220,
        450
      ]
    },
    "autoZoom": {
      "enabled": true,
      "lockX": false,
      "restZoom": 1,
      "focusZoom": 2.4,
      "delayMs": 350,
      "zoomMs": 450,
      "zoomOutMs": 280,
      "holdMs": 700,
      "panMs": 280,
      "bounceMergeMs": 5500,
      "bouncePanMs": 900,
      "ease": "cubic-in-out"
    },
    "cursor": {
      "movement": "human",
      "duration": [
        290,
        450
      ],
      "overshoot": 0.12,
      "hesitation": [
        90,
        170
      ],
      "curvature": 0.4
    }
  },
  "output": {
    "dir": "output",
    "resolution": {"width":1080,"height":1920},
    "fps": 30,
    "fitMode": "cover",
    "keepRaw": true,
    "speed": 1
  },
  "scenes": [
    {
      "id": "ema-strategy",
      "description": "Build the complete EMA strategy on camera: add every node (indicators first, then the strategy + trade-overlay nodes, ), enter settings, draw every connection, then execute. Fully generated from flows/flow-ema.json by scripts/gen-pipeline.js.",
      "target": {"selector":".react-flow","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit2","shift":true},
        {"at":0.4,"type":"injectFlow","file":"flows/ema/build.json"},
        {"at":1.6,"type":"press","key":"Digit2","shift":true},
        {"at":2,"type":"injectFlow","file":"flows/ema/build.json","nodeCount":0}
      ],
      "durationSec": 110.2,
      "holdAfterSec": 2,
      "autoCamera": true,
      "tracks": {
        "input": [
          {"at":0.8,"type":"rightClick","selector":".react-flow__pane","position":{"x":-271,"y":518},"flowPos":{"x":40,"y":540},"addsNodeId":1},
          {"at":1.8,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"candles","focusZoom":2.6,"focusSession":1},
          {"at":4.2,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Candles\"))"},
          {"at":5.3,"type":"fill","selector":".react-flow__node[data-id=\"1\"] input[placeholder=\"int\"]","nth":0,"text":"1000","focusZoom":3,"focusSession":1},
          {"at":9.1,"type":"rightClick","selector":".react-flow__pane","position":{"x":-66,"y":436},"flowPos":{"x":340,"y":420},"addsNodeId":2},
          {"at":10.1,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"ema","focusZoom":2.6,"focusSession":2},
          {"at":12.5,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"EMA\"))"},
          {"at":13.6,"type":"fill","selector":".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]","nth":0,"text":"9","focusZoom":3,"focusSession":2},
          {"at":17.4,"type":"drag","selector":".react-flow__node[data-id=\"1\"] .react-flow__handle[data-handleid=\"output-3\"]","toSelector":".react-flow__node[data-id=\"2\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":2.6,"focusSelector":".react-flow__node[data-id=\"2\"]"},
          {"at":20.8,"type":"rightClick","selector":".react-flow__pane","position":{"x":-66,"y":600},"flowPos":{"x":340,"y":660},"addsNodeId":3},

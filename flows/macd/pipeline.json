    {
      "id": "chart-reveal",
      "description": "Reveal the chart with the plotted MACD result and trade overlays from PLOT.TRADES after running the strategy.",
      "target": {"selector":"#main-chart","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit1","shift":true}
      ],
      "durationSec": 6,
      "holdAfterSec": 1,
      "autoCamera": false,
      "tracks": {
        "input": [
          {"at":1.4,"type":"drag","point":{"x":950,"y":540},"to":{"x":1550,"y":540}}
        ]
      }
    },
    {
      "id": "backtest-overview",
      "description": "Show the Backtest Results panel (Overview tab) with the hero metrics, verdict and equity sparkline for the MACD run.",
      "target": {"selector":"[data-testid=\"backtest-panel\"]","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit5","shift":true}
      ],
      "durationSec": 7,
      "holdAfterSec": 1,
      "autoCamera": false,
      "tracks": {
        "input": []
      }
    }

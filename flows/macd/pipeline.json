{
  "name": "macd-strategy-reel",
  "app": {
    "url": "http://localhost:3000/",
    "viewport": {"width":1920,"height":1080},
    "waitForPyodide": true,
    "pyodideLoaderSelector": ".app-pyodide-loader",
    "readySelector": "#main-chart",
    "readyTimeoutMs": 120000
  },
  "record": {
    "browser": "chromium",
    "headless": false,
    "timelineOffsetMs": 0,
    "settleMs": 300,
    "humanize": {
      "seed": 7,
      "jitter": 0.15,
      "scale": 1,
      "preActionPause": [
        220,
        450
      ]
    },
    "autoZoom": {
      "enabled": true,
      "lockX": false,
      "restZoom": 1,
      "focusZoom": 2.4,
      "delayMs": 350,
      "zoomMs": 450,
      "zoomOutMs": 280,
      "holdMs": 700,
      "panMs": 280,
      "bounceMergeMs": 5500,
      "bouncePanMs": 900,
      "ease": "cubic-in-out"
    },
    "cursor": {
      "movement": "human",
      "duration": [
        290,
        450
      ],
      "overshoot": 0.12,
      "hesitation": [
        90,
        170
      ],
      "curvature": 0.4
    }
  },
  "output": {
    "dir": "output",
    "resolution": {"width":1080,"height":1920},
    "fps": 30,
    "fitMode": "cover",
    "keepRaw": true,
    "speed": 1
  },
  "scenes": [
    {
      "id": "macd-strategy",
      "description": "Build the complete MACD strategy on camera: add every node (indicators first, then the strategy + trade-overlay nodes, ), enter settings, draw every connection, then execute. Fully generated from flows/flow-macd.json by scripts/gen-pipeline.js.",
      "target": {"selector":".react-flow","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit2","shift":true},
        {"at":0.4,"type":"injectFlow","file":"flows/macd/build.json"},
        {"at":1.6,"type":"press","key":"Digit2","shift":true},
        {"at":2,"type":"injectFlow","file":"flows/macd/build.json","nodeCount":0}
      ],
      "durationSec": 115.8,
      "holdAfterSec": 2,
      "autoCamera": true,

          {"at":83.5,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Strategy Run\"))"},
          {"at":86,"type":"drag","selector":".react-flow__node[data-id=\"6\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":2.6,"focusSelector":".react-flow__node[data-id=\"8\"]"},
          {"at":88,"type":"drag","selector":".react-flow__node[data-id=\"7\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"input-1\"]","focusZoom":2.6,"focusSelector":".react-flow__node[data-id=\"8\"]"},
          {"at":91.4,"type":"rightClick","selector":".react-flow__pane","position":{"x":547,"y":518},"flowPos":{"x":1240,"y":540},"addsNodeId":9},
          {"at":92.4,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"plot trades","focusZoom":2.6,"focusSession":9},
          {"at":94.8,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Plot Trades\"))"},
          {"at":97.3,"type":"drag","selector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"9\"] .react-flow__handle[data-handleid=\"input-1\"]","focusZoom":2.6,"focusSelector":".react-flow__node[data-id=\"9\"]"},
          {"at":99.3,"type":"drag","selector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"output-1\"]","toSelector":".react-flow__node[data-id=\"9\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":2.6,"focusSelector":".react-flow__node[data-id=\"9\"]"},
          {"at":105.7,"type":"click","selector":"button[title=\"Execute flow\"]"}
        ],
        "attention": [
          {"at":4.9,"type":"mark","selector":".react-flow__node[data-id=\"1\"] input[placeholder=\"int\"]","nth":0,"padding":4,"durationMs":1200},
          {"at":13.2,"type":"mark","selector":".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]","nth":0,"padding":4,"durationMs":1200},
          {"at":24.9,"type":"mark","selector":".react-flow__node[data-id=\"3\"] input[placeholder=\"int\"]","nth":0,"padding":4,"durationMs":1200},
          {"at":36.6,"type":"mark","selector":".react-flow__node[data-id=\"4\"] .aspect-square","padding":4,"durationMs":1200},
          {"at":49.1,"type":"mark","selector":".react-flow__node[data-id=\"5\"] .aspect-square","padding":4,"durationMs":1200}
        ]
      }
    },
    {
      "id": "chart-reveal",
      "description": "Reveal the chart with the plotted EMA result and trade overlays from PLOT.TRADES after running the strategy.",
      "target": {"selector":"#main-chart","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit1","shift":true}
      ],
      "durationSec": 6,
      "holdAfterSec": 1,
      "autoCamera": false,
      "tracks": {
        "input": [
          {"at":1.4,"type":"drag","point":{"x":950,"y":540},"to":{"x":1550,"y":540}}
        ]
      }
    },
    {
      "id": "backtest-overview",
      "description": "Show the Backtest Results panel (Overview tab) with the hero metrics, verdict and equity sparkline for the EMA run.",
      "target": {"selector":"[data-testid=\"backtest-panel\"]","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit5","shift":true}
      ],
      "durationSec": 7,
      "holdAfterSec": 1,
      "autoCamera": false,
      "tracks": {
        "input": []
      }
    }
  ]
}

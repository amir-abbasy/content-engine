{
  "$schema": "./pipeline.schema.json",
  "name": "algo-trading-reel-01",
  "app": {
    "url": "http://localhost:3000/",
    "viewport": { "width": 1920, "height": 1080 },
    "waitForPyodide": true,
    "pyodideLoaderSelector": ".app-pyodide-loader",
    "readySelector": "#main-chart",
    "readyTimeoutMs": 120000
  },
  "record": {
    "browser": "chromium",
    "headless": false,
    "timelineOffsetMs": 0,
    "settleMs": 600,
    "humanize": {
      "seed": 7,
      "jitter": 0.15,
      "scale": 1.0,
      "preActionPause": [120, 280]
    },
    "autoZoom": {
      "enabled": true,
      "lockX": true,
      "restZoom": 1.0,
      "focusZoom": 2.0,
      "delayMs": 1000,
      "zoomMs": 1000,
      "zoomOutMs": 450,
      "holdMs": 1000,
      "ease": "cubic-in-out"
    },
    "cursor": {
      "movement": "human",
      "duration": [380, 720],
      "overshoot": 0.12,
      "hesitation": [70, 180],
      "curvature": 0.4
    }
  },
  "output": {
    "dir": "output",
    "resolution": { "width": 1080, "height": 1920 },
    "fps": 30,
    "fitMode": "cover",
    "keepRaw": true
  },
  "scenes": [
    {
      "id": "01-build-strategy",
      "description": "FOCUS BUILD (2 steps): add Candles, then add EMA(20) and set its length. Camera is auto-generated with lockX (no horizontal movement): full view -> on search typing, after 1s delay zoom in to read the menu -> on result click, zoom out to full view. Same for the EMA length input.",
      "target": { "selector": ".react-flow", "aspect": "9:16", "anchor": "center" },
      "setup": [
        { "at": 0.0, "type": "press", "key": "Digit2", "shift": true },
        { "at": 0.5, "type": "injectFlow", "file": "flows/ema-plot.json" },
        { "at": 1.8, "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 0 }
      ],
      "durationSec": 19.5,
      "holdAfterSec": 1.0,
      "autoCamera": true,
      "tracks": {
        "input": [
          { "at": 0.5,  "type": "rightClick", "selector": ".react-flow__pane", "position": {"x": 820, "y": 250} },
          { "at": 1.6,  "type": "fill",  "selector": "input[placeholder=\"Search nodes...\"]", "text": "ohlcv", "focusZoom": 2.0 },
          { "at": 4.3,  "type": "click", "selector": "[role=\"menuitem\"]:has-text(\"Candles\")" },
          { "at": 5.4,  "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 1 },

          { "at": 7.0,  "type": "rightClick", "selector": ".react-flow__pane", "position": {"x": 820, "y": 650} },
          { "at": 8.1,  "type": "fill",  "selector": "input[placeholder=\"Search nodes...\"]", "text": "ta.ema", "focusZoom": 2.0 },
          { "at": 10.8, "type": "click", "selector": "[role=\"menuitem\"]" },
          { "at": 11.9, "type": "injectFlow", "file": "flows/ema-plot.json", "nodeCount": 2 },
          { "at": 13.5, "type": "fill",  "selector": ".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]", "text": "20", "focusZoom": 2.4 }
        ]
      }
    },
    {
      "id": "02-price-chart",
      "description": "Run the finished strategy, then slowly pan the price chart back through history — candles + both EMAs scrolling past with eased motion.",
      "target": { "selector": "#main-chart", "aspect": "9:16", "anchor": "right" },
      "setup": [
        { "at": 0.0, "type": "click", "selector": "button[title=\"Execute flow\"]" },
        { "at": 6.0, "type": "press", "key": "Digit1", "shift": true }
      ],
      "durationSec": 7.0,
      "tracks": {
        "camera": [
          { "at": 0.0, "point": {"x": 1180, "y": 561}, "ease": "cubic-out" },
          { "at": 0.7, "point": {"x": 1180, "y": 561}, "ease": "linear" },
          { "at": 6.0, "point": {"x": 345,  "y": 561}, "ease": "cubic-in-out" }
        ]
      }
    }
  ]
}

{
  "name": "bb-strategy-reel",
  "app": {
    "url": "http://localhost:3000/",
    "viewport": {"width":1920,"height":1080},
    "waitForPyodide": true,
    "pyodideLoaderSelector": ".app-pyodide-loader",
    "readySelector": "#main-chart",
    "readyTimeoutMs": 120000
  },
  "record": {
    "browser": "chromium",
    "headless": false,
    "timelineOffsetMs": 0,
    "settleMs": 300,
    "humanize": {
      "seed": 7,
      "jitter": 0.15,
      "scale": 1,
      "preActionPause": [
        40,
        90
      ]
    },
    "autoZoom": {
      "enabled": true,
      "lockX": false,
      "restZoom": 1,
      "focusZoom": 2,
      "delayMs": 350,
      "zoomMs": 500,
      "zoomOutMs": 300,
      "holdMs": 400,
      "panMs": 250,
      "ease": "cubic-in-out"
    },
    "cursor": {
      "movement": "human",
      "duration": [
        140,
        260
      ],
      "overshoot": 0.12,
      "hesitation": [
        25,
        60
      ],
      "curvature": 0.4
    }
  },
  "output": {
    "dir": "output",
    "resolution": {"width":1080,"height":1920},
    "fps": 30,
    "fitMode": "cover",
    "keepRaw": true,
    "speed": 1
  },
  "scenes": [
    {
      "id": "bb-strategy",
      "description": "Build the complete BB strategy on camera: add every node, enter its settings, draw every connection, then run the backtest. Fully generated from flows/flow-bb.json by scripts/gen-pipeline.js.",
      "target": {"selector":".react-flow","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit2","shift":true},
        {"at":0.4,"type":"injectFlow","file":"flows/bb/build.json"},
        {"at":1.6,"type":"press","key":"Digit2","shift":true},
        {"at":2,"type":"injectFlow","file":"flows/bb/build.json","nodeCount":0}
      ],
      "durationSec": 79.3,
      "holdAfterSec": 2,
      "autoCamera": true,
      "tracks": {
        "input": [
          {"at":0.8,"type":"rightClick","selector":".react-flow__pane","position":{"x":-272,"y":239},"addsNodeId":1},
          {"at":1.8,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"candles","focusZoom":2,"focusSession":1},
          {"at":4.2,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Candles\"))"},
          {"at":5.3,"type":"fill","selector":".react-flow__node[data-id=\"1\"] input[placeholder=\"int\"]","nth":0,"text":"1000","focusZoom":2.4,"focusSession":1},
          {"at":8.5,"type":"rightClick","selector":".react-flow__pane","position":{"x":-42,"y":261},"addsNodeId":2},
          {"at":9.5,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"rma","focusZoom":2,"focusSession":2},
          {"at":11.9,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"RMA\"))"},
          {"at":13,"type":"fill","selector":".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]","nth":0,"text":"10","focusZoom":2.4,"focusSession":2},
          {"at":16.2,"type":"drag","selector":".react-flow__node[data-id=\"1\"] .react-flow__handle[data-handleid=\"output-3\"]","toSelector":".react-flow__node[data-id=\"2\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"2\"]"},
          {"at":19.6,"type":"rightClick","selector":".react-flow__pane","position":{"x":-15,"y":375},"addsNodeId":3},
          {"at":20.6,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"bbands","focusZoom":2,"focusSession":3},
          {"at":23,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"BBANDS\"))"},
          {"at":24.1,"type":"fill","selector":".react-flow__node[data-id=\"3\"] input[placeholder=\"int\"]","nth":0,"text":"20","focusZoom":2.4,"focusSession":3},
          {"at":27.3,"type":"drag","selector":".react-flow__node[data-id=\"1\"] .react-flow__handle[data-handleid=\"output-3\"]","toSelector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"3\"]"},
          {"at":30.7,"type":"rightClick","selector":".react-flow__pane","position":{"x":203,"y":212},"addsNodeId":4},
          {"at":31.7,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"plot","focusZoom":2,"focusSession":4},
          {"at":34.1,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Plot\"))"},
          {"at":35.2,"type":"click","selector":".react-flow__node[data-id=\"4\"] .aspect-square","focusZoom":2,"focusSelector":"[role=\"dialog\"]","focusSession":4},
          {"at":36.4,"type":"click","selector":"[role=\"dialog\"] button[title=\"#3b82f6\"]","focusSession":4},
          {"at":39,"type":"drag","selector":".react-flow__node[data-id=\"2\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"4\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"4\"]"},
          {"at":42.4,"type":"rightClick","selector":".react-flow__pane","position":{"x":294,"y":430},"addsNodeId":5},
          {"at":43.4,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"plot","focusZoom":2,"focusSession":5},
          {"at":45.8,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Plot\"))"},
          {"at":46.9,"type":"click","selector":".react-flow__node[data-id=\"5\"] .aspect-square","focusZoom":2,"focusSelector":"[role=\"dialog\"]","focusSession":5},
          {"at":48.1,"type":"click","selector":"[role=\"dialog\"] button[title=\"rgba(187, 247, 208, 1)\"]","focusSession":5},
          {"at":50.7,"type":"drag","selector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"5\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"5\"]"},
          {"at":52.7,"type":"drag","selector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"output-1\"]","toSelector":".react-flow__node[data-id=\"5\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"5\"]"},
          {"at":54.7,"type":"drag","selector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"output-2\"]","toSelector":".react-flow__node[data-id=\"5\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"5\"]"},
          {"at":58.1,"type":"rightClick","selector":".react-flow__pane","position":{"x":319,"y":637},"addsNodeId":6},
          {"at":59.1,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"fill","focusZoom":2,"focusSession":6},
          {"at":61.5,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Fill\"))"},
          {"at":62.6,"type":"click","selector":".react-flow__node[data-id=\"6\"] .aspect-square","focusZoom":2,"focusSelector":"[role=\"dialog\"]","focusSession":6},
          {"at":63.8,"type":"click","selector":"[role=\"dialog\"] button[title=\"rgba(187, 247, 208, 0.27)\"]","focusSession":6},
          {"at":66.4,"type":"drag","selector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"6\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"6\"]"},
          {"at":68.4,"type":"drag","selector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"output-2\"]","toSelector":".react-flow__node[data-id=\"6\"] .react-flow__handle[data-handleid=\"input-1\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"6\"]"},
          {"at":74.8,"type":"click","selector":"button[title=\"Execute flow\"]"}
        ],
        "attention": [
          {"at":4.9,"type":"mark","selector":".react-flow__node[data-id=\"1\"] input[placeholder=\"int\"]","nth":0,"padding":4,"durationMs":1200},
          {"at":12.6,"type":"mark","selector":".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]","nth":0,"padding":4,"durationMs":1200},
          {"at":23.7,"type":"mark","selector":".react-flow__node[data-id=\"3\"] input[placeholder=\"int\"]","nth":0,"padding":4,"durationMs":1200},
          {"at":34.8,"type":"mark","selector":".react-flow__node[data-id=\"4\"] .aspect-square","padding":4,"durationMs":1200},
          {"at":46.5,"type":"mark","selector":".react-flow__node[data-id=\"5\"] .aspect-square","padding":4,"durationMs":1200},
          {"at":62.2,"type":"mark","selector":".react-flow__node[data-id=\"6\"] .aspect-square","padding":4,"durationMs":1200}
        ]
      }
    },
    {
      "id": "chart-reveal",
      "description": "Reveal the chart with the plotted BB result after running the strategy.",
      "target": {"selector":"#main-chart","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit1","shift":true}
      ],
      "durationSec": 6,
      "holdAfterSec": 1,
      "autoCamera": false,
      "tracks": {
        "input": [
          {"at":1.4,"type":"drag","point":{"x":950,"y":540},"to":{"x":1550,"y":540}}
        ]
      }
    }
  ]
}

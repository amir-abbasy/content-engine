{
  "name": "content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular automated short-form trading content engine. Phase 1: pipeline-driven app recorder.",
  "scripts": {
    "record": "node src/record.js",
    "record:headed": "node src/record.js --headed",
    "record:headless": "node src/record.js --headless",
    "gen:build": "node scripts/gen-build.js",
    "gen:pipeline": "node scripts/gen-pipeline.js",
    "gen": "node scripts/gen.js",
    "flow": "node scripts/flow.js",
    "studio": "node src/studio/start.js",
    "studio:api": "node src/studio/server.js",
    "studio:web": "vite --config studio/vite.config.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  }
}

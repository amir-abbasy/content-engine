{
  "$schema": "./pipeline.schema.json",
  "name": "algo-trading-reel-01",
  "app": {
    "url": "http://localhost:3000/",
    "viewport": {"width":1920,"height":1080},
    "waitForPyodide": true,
    "pyodideLoaderSelector": ".app-pyodide-loader",
    "readySelector": "#main-chart",
    "readyTimeoutMs": 120000
  },
  "record": {
    "browser": "chromium",
    "headless": false,
    "timelineOffsetMs": 0,
    "settleMs": 300,
    "humanize": {
      "seed": 7,
      "jitter": 0.15,
      "scale": 1,
      "preActionPause": [
        40,
        90
      ]
    },
    "autoZoom": {
      "enabled": true,
      "lockX": false,
      "restZoom": 1,
      "focusZoom": 2,
      "delayMs": 350,
      "zoomMs": 500,
      "zoomOutMs": 300,
      "holdMs": 400,
      "panMs": 250,
      "ease": "cubic-in-out"
    },
    "cursor": {
      "movement": "human",
      "duration": [
        140,
        260
      ],
      "overshoot": 0.12,
      "hesitation": [
        25,
        60
      ],
      "curvature": 0.4
    }
  },
  "output": {
    "dir": "output",
    "resolution": {"width":1080,"height":1920},
    "fps": 30,
    "fitMode": "cover",
    "keepRaw": true,
    "speed": 1
  },
  "scenes": [
    {
      "id": "01-build-strategy",
      "description": "FULL BUILD (5 nodes): Candles -> EMA20 (len 20) -> EMA50 (len 50) -> Plot EMA20 (color) -> Plot EMA50 (color). Camera is auto-generated: it GLIDES horizontally to each hotspot, zooms in (1s) to frame the menu/field/dialog, holds pixel-locked while typing/choosing, then snaps out (450ms) once the node lands in the flow. Value inputs and color pickers follow the same zoom-in / hold / pull-out feel.",
      "target": {"selector":".react-flow","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit2","shift":true},
        {"at":0.5,"type":"injectFlow","file":"flows/ema-plot.json"},
        {"at":1.8,"type":"injectFlow","file":"flows/ema-plot.json","nodeCount":0}
      ],
      "durationSec": 28,
      "holdAfterSec": 0.5,
      "autoCamera": true,
      "tracks": {
        "input": [
          {"at":0.4,"type":"rightClick","selector":".react-flow__pane","position":{"x":507,"y":323}},
          {"at":1.2,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"ohlcv","focusZoom":2},
          {"at":2.2,"type":"click","selector":"[role=\"menuitem\"]:has-text(\"Candles\")"},
          {"at":2.8,"type":"injectFlow","file":"flows/ema-plot.json","nodeCount":1},
          {"at":3.8,"type":"rightClick","selector":".react-flow__pane","position":{"x":933,"y":157}},
          {"at":4.6,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"ta.ema","focusZoom":2},
          {"at":5.6,"type":"click","selector":"[role=\"menuitem\"]"},
          {"at":6.2,"type":"injectFlow","file":"flows/ema-plot.json","nodeCount":2},
          {"at":7.1,"type":"fill","selector":".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]","text":"20","focusZoom":2.4},
          {"at":9.1,"type":"rightClick","selector":".react-flow__pane","position":{"x":933,"y":661}},
          {"at":9.9,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"ta.ema","focusZoom":2},
          {"at":10.9,"type":"click","selector":"[role=\"menuitem\"]"},
          {"at":11.5,"type":"injectFlow","file":"flows/ema-plot.json","nodeCount":3},
          {"at":12.4,"type":"fill","selector":".react-flow__node[data-id=\"3\"] input[placeholder=\"int\"]","text":"50","focusZoom":2.4},
          {"at":14.4,"type":"rightClick","selector":".react-flow__pane","position":{"x":1388,"y":310}},
          {"at":15.2,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"plot","focusZoom":2},
          {"at":16.2,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Plot\"))"},
          {"at":16.8,"type":"injectFlow","file":"flows/ema-plot.json","nodeCount":4},
          {"at":17.7,"type":"click","selector":".react-flow__node[data-id=\"4\"] .aspect-square","focusZoom":2,"focusSelector":"[role=\"dialog\"]"},
          {"at":19.7,"type":"click","selector":"[role=\"dialog\"] button[title=\"#eab308\"]"},
          {"at":21.2,"type":"rightClick","selector":".react-flow__pane","position":{"x":1388,"y":550}},
          {"at":22,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"plot","focusZoom":2},
          {"at":23,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Plot\"))"},
          {"at":23.6,"type":"injectFlow","file":"flows/ema-plot.json","nodeCount":5},
          {"at":24.5,"type":"click","selector":".react-flow__node[data-id=\"5\"] .aspect-square","focusZoom":2,"focusSelector":"[role=\"dialog\"]"},
          {"at":26.5,"type":"click","selector":"[role=\"dialog\"] button[title=\"#06b6d4\"]"}
        ],
        "attention": [
          {"at":6.6,"type":"mark","selector":".react-flow__node[data-id=\"2\"] input[placeholder=\"int\"]","durationMs":1700},
          {"at":11.9,"type":"mark","selector":".react-flow__node[data-id=\"3\"] input[placeholder=\"int\"]","durationMs":1700},
          {"at":18.7,"type":"mark","selector":"[role=\"dialog\"] button[title=\"#eab308\"]","padding":4,"durationMs":1100},
          {"at":25.5,"type":"mark","selector":"[role=\"dialog\"] button[title=\"#06b6d4\"]","padding":4,"durationMs":1100}
        ]
      }
    },
    {
      "id": "02-price-chart",
      "description": "Run the finished strategy, then slowly pan the price chart back through history — candles + both EMAs scrolling past with eased motion.",
      "target": {"selector":"#main-chart","aspect":"9:16","anchor":"right"},
      "setup": [
        {"at":0,"type":"click","selector":"button[title=\"Execute flow\"]"},
        {"at":6,"type":"press","key":"Digit1","shift":true}
      ],
      "durationSec": 7,
      "tracks": {
        "camera": [
          {
            "at": 0,
            "point": {"x":1180,"y":561},
            "ease": "cubic-out"
          },
          {
            "at": 0.7,
            "point": {"x":1180,"y":561},
            "ease": "linear"
          },
          {
            "at": 6,
            "point": {"x":345,"y":561},
            "ease": "cubic-in-out"
          }
        ]
      }
    },
    {
      "id": "03-complete-strategy",
      "description": "COMPLETE THE STRATEGY (shows manual wiring): add Greater Than + Less Than conditions and a Strategy Run backtest node (+ Plot Trades), then DRAG the edges — EMA20/EMA50 into both conditions, Greater->Long when, Less->Short when, Candles->market_data, trades->Plot Trades — and run the backtest. Unlike scene 1 (instant injectFlow wiring), every connection is drawn by hand. Node ids match flows/strategy-build.json build order.",
      "target": {"selector":".react-flow","aspect":"9:16","anchor":"center"},
      "setup": [
        {"at":0,"type":"press","key":"Digit2","shift":true},
        {"at":0.4,"type":"injectFlow","file":"flows/strategy-build.json"},
        {"at":1.6,"type":"press","key":"Digit2","shift":true},
        {"at":2,"type":"injectFlow","file":"flows/strategy-build.json","nodeCount":5}
      ],
      "durationSec": 53.5,
      "holdAfterSec": 2,
      "autoCamera": true,
      "tracks": {
        "input": [
          {"at":0.8,"type":"rightClick","selector":".react-flow__pane","position":{"x":1167,"y":232},"addsNodeId":6},
          {"at":1.8,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"greater than","focusZoom":2,"focusSession":6},
          {"at":4.2,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Greater Than\"))"},
          {"at":6.7,"type":"drag","selector":".react-flow__node[data-id=\"2\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"6\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"6\"]"},
          {"at":8.7,"type":"drag","selector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"6\"] .react-flow__handle[data-handleid=\"input-1\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"6\"]"},
          {"at":12.1,"type":"rightClick","selector":".react-flow__pane","position":{"x":1167,"y":532},"addsNodeId":7},
          {"at":13.1,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"less than","focusZoom":2,"focusSession":7},
          {"at":15.5,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Less Than\"))"},
          {"at":18,"type":"drag","selector":".react-flow__node[data-id=\"2\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"7\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"7\"]"},
          {"at":20,"type":"drag","selector":".react-flow__node[data-id=\"3\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"7\"] .react-flow__handle[data-handleid=\"input-1\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"7\"]"},
          {"at":23.4,"type":"rightClick","selector":".react-flow__pane","position":{"x":1459,"y":382},"addsNodeId":8},
          {"at":24.4,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"strategy run","focusZoom":2,"focusSession":8},
          {"at":26.8,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Strategy Run\"))"},
          {"at":29.3,"type":"drag","selector":".react-flow__node[data-id=\"6\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"input-1\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"8\"]"},
          {"at":31.3,"type":"drag","selector":".react-flow__node[data-id=\"7\"] .react-flow__handle[data-handleid=\"output-0\"]","toSelector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"input-2\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"8\"]"},
          {"at":33.3,"type":"drag","selector":".react-flow__node[data-id=\"1\"] .react-flow__handle[data-handleid=\"output-9\"]","toSelector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"8\"]"},
          {"at":36.7,"type":"rightClick","selector":".react-flow__pane","position":{"x":1746,"y":382},"addsNodeId":9},
          {"at":37.7,"type":"fill","selector":"input[placeholder=\"Search nodes...\"]","text":"plot trades","focusZoom":2,"focusSession":9},
          {"at":40.1,"type":"click","selector":"[role=\"menuitem\"]:has(:text-is(\"Plot Trades\"))"},
          {"at":42.6,"type":"drag","selector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"output-1\"]","toSelector":".react-flow__node[data-id=\"9\"] .react-flow__handle[data-handleid=\"input-0\"]","focusZoom":1.6,"focusSelector":".react-flow__node[data-id=\"9\"]"},
          {"at":49,"type":"click","selector":"button[title=\"Execute flow\"]"}
        ],
        "attention": [
          {"at":34.7,"type":"mark","selector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"input-1\"]","padding":6,"durationMs":1500},
          {"at":36.7,"type":"mark","selector":".react-flow__node[data-id=\"8\"] .react-flow__handle[data-handleid=\"input-2\"]","padding":6,"durationMs":1500}
        ]
      }
    }
  ]
}
